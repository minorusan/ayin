{
  "name": "ayin",
  "version": "1.0.390",
  "license": "MIT",
  "description": "A small, model-agnostic terminal coding agent — an agentic loop in your shell against a self-hosted LLM (Ollama or any OpenAI-compatible endpoint).",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "ayin": "dist/index.js"
  },
  "files": [
    "dist",
    "prompts",
    "help",
    "assets",
    "README.md",
    "SETUP.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "node tool/copy-executor-configs.mjs && tsc --watch",
    "prepublishOnly": "node tool/check-registry.mjs",
    "check:glyphs": "node tool/check-glyphs.mjs",
    "check:tool-icons": "node tool/check-tool-icons.mjs",
    "check:gates": "node tool/check-gates.mjs",
    "check:explore": "node tool/check-explore.mjs",
    "check:watch": "node tool/check-watch.mjs",
    "check:indulge": "node tool/check-indulge.mjs",
    "check:modes": "node tool/check-modes.mjs",
    "check:bang": "node tool/check-bang.mjs",
    "check:launch": "node tool/check-launch.mjs",
    "check:diff": "node tool/check-diff.mjs",
    "check:prefab": "node tool/check-prefab.mjs",
    "check:animator": "node tool/check-animator.mjs",
    "check:unity": "node tool/check-unity.mjs",
    "check:chore": "node tool/check-chore.mjs",
    "check:readguard": "node tool/check-readguard.mjs",
    "check:readwindow": "node tool/check-readwindow.mjs",
    "check:help": "node tool/check-help.mjs",
    "check:testrun": "node tool/check-testrun.mjs",
    "check:plan": "node tool/check-plan.mjs",
    "prebuild": "node tool/check-glyphs.mjs && node tool/check-hygiene.mjs",
    "check:prompts": "node tool/check-prompts.mjs",
    "audit:prompts": "node tool/dump-prompts.mjs",
    "bench:arduino": "node tool/arduino-bench.mjs",
    "postbuild": "node tool/copy-executor-configs.mjs && node tool/check-prompts.mjs && node tool/check-orphans.mjs && node tool/check-tool-icons.mjs",
    "release": "npm publish --registry ${AYIN_REGISTRY:?set AYIN_REGISTRY to your private registry}",
    "check:sentinaile": "node tool/check-sentinaile.mjs",
    "check:vendor": "node tool/check-vendor.mjs",
    "check:tsindulger": "node tool/check-ts-indulger.mjs",
    "check:updater": "node tool/check-updater.mjs",
    "check:window": "node tool/check-window.mjs",
    "check:connectors": "node tool/check-connector-loop.mjs",
    "check:unwatch": "node tool/check-unwatch.mjs",
    "check:helppage": "node tool/check-helppage.mjs",
    "check:cli": "node tool/check-cli.mjs",
    "check:tooldocs": "node tool/check-tooldocs.mjs",
    "check:hygiene": "node tool/check-hygiene.mjs",
    "check:comments": "node tool/check-comments.mjs",
    "check:vision": "node tool/check-vision.mjs",
    "check:parser": "node tool/check-parser.mjs",
    "check:glm": "node tool/check-glm.mjs",
    "check:qwen": "node tool/check-qwen.mjs",
    "check:rename": "node tool/check-rename.mjs",
    "check:qa-unity": "node tool/check-qa-unity.mjs",
    "unity:compile": "node tool/unity-compile.mjs",
    "check:io": "node tool/check-io-tools.mjs",
    "check:jira": "node tool/check-jira.mjs",
    "check:slack": "node tool/check-slack.mjs",
    "check:sprint": "node tool/check-sprint.mjs",
    "check:jira-indulge": "node tool/check-indulge-jira.mjs",
    "check:explore-corpus": "node tool/check-explore-corpus.mjs",
    "check:cost": "node tool/check-cost.mjs",
    "check:dart": "node tool/check-dart.mjs",
    "check:weave": "node tool/check-weave.mjs",
    "check:announced": "node tool/check-announced.mjs",
    "check:wrap": "node tool/check-wrap.mjs"
  },
  "dependencies": {
    "@langchain/core": "^1.2.9",
    "@langchain/langgraph": "^1.4.12",
    "blessed": "^0.1.81",
    "openai": "^7.4.0",
    "sharp": "^0.33.5",
    "undici": "^6.20.0"
  },
  "devDependencies": {
    "@types/blessed": "^0.1.25",
    "@types/node": "^20.10.0",
    "typescript": "^5.3.3"
  }
}
