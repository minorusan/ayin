{
  "name": "ayin",
  "version": "1.0.201",
  "description": "A small, model-agnostic terminal coding agent — an agentic loop in your shell against a self-hosted LLM (Ollama or any OpenAI-compatible endpoint).",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "ayin": "./dist/index.js",
    "tg-auth": "./dist/tg-auth-cmd.js"
  },
  "files": [
    "dist",
    "prompts",
    "README.md",
    "SETUP.md",
    "LICENSE"
  ],
  "publishConfig": {
    "registry": "http://192.168.0.229:4873"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "prepublishOnly": "tsc",
    "check:glyphs": "node tool/check-glyphs.mjs",
    "check:gates": "node tool/check-gates.mjs",
    "check:explore": "node tool/check-explore.mjs",
    "prebuild": "node tool/check-glyphs.mjs",
    "check:prompts": "node tool/check-prompts.mjs",
    "postbuild": "node tool/check-prompts.mjs"
  },
  "dependencies": {
    "blessed": "^0.1.81",
    "sharp": "^0.33.5",
    "telegram": "^2.26.22",
    "undici": "^6.20.0"
  },
  "devDependencies": {
    "@types/blessed": "^0.1.25",
    "@types/node": "^20.10.0",
    "typescript": "^5.3.3"
  }
}
